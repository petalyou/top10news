# Local development settings (copy to .env). On Cloudflare, plain settings go in wrangler.toml [vars]
# and secrets (GEMINI_API_KEY, CRON_SECRET) in the Worker's Settings → Variables and Secrets.

# --- Gemini (summaries; free key at aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Cron auth: the Worker's Cron Trigger calls /api/cron/hourly-ingest with "Authorization: Bearer $CRON_SECRET" ---
CRON_SECRET=generate-a-long-random-string

# --- Snapshot storage ---
# On Cloudflare the R2 bucket is bound as SNAPSHOTS in wrangler.toml (no keys needed).
# Locally (npm run dev / ingest / seed-demo) snapshots live in .data/.

# --- Site ---
SITE_URL=https://top10hourly.com
NEXT_PUBLIC_DISPLAY_TIMEZONE=America/New_York
EDITION_TIMEZONE=America/New_York
# Cloudflare Web Analytics token (optional; only if automatic setup isn't available)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
# --- Legal pages (/terms, /privacy, /publishers) ---
# Domain shown in the Terms; defaults to the SITE_URL host.
SITE_DOMAIN=top10hourly.com
CONTACT_EMAIL=yes2mountain@gmail.com
LEGAL_ENTITY_NAME="Top10 Hourly"
LEGAL_EFFECTIVE_DATE="November 2026"
# Optional per-purpose overrides; each defaults to CONTACT_EMAIL.
PRIVACY_EMAIL=
PUBLISHERS_EMAIL=
DMCA_EMAIL=
HELLO_EMAIL=
# Sponsor mailto target; defaults to HELLO_EMAIL.
SPONSOR_EMAIL=

# --- Ingest ---
# Comma-separated publisher domains that opted out (never ingested)
OPTOUT_DOMAINS=
# INGEST_USER_AGENT="Top10HourlyBot/1.0 (+https://top10hourly.com/publishers)"

# --- Freshness ranking (optional; defaults shown) ---
# First time in the Top 10: score x RANK_NEW_BOOST. After RANK_GRACE_HOURS in the Top 10,
# score x RANK_DECAY_PER_HOUR for each extra hour, never below RANK_DECAY_FLOOR.
RANK_NEW_BOOST=1.25
RANK_GRACE_HOURS=3
RANK_DECAY_PER_HOUR=0.85
RANK_DECAY_FLOOR=0.4

# --- Sponsors / ads ---
# All sponsor slots are hidden until this is "true" (bookings live in data/sponsors.json).
SHOW_SPONSORS=false
